# Copy this to .env and fill in values

# Database (SQLite for local dev, Postgres URL on Render)
DATABASE_URL=sqlite:///./visitors.db
# On Render: DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Admin password to access /viewers dashboard
ADMIN_PASSWORD=changeme-strong-password

# JWT secret (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# CORS - your frontend URL
FRONTEND_ORIGIN=https://portfolio-mu-orpin-21.vercel.app
